{
  "info": {
    "name": "Backend CRUD Assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '02 Register') pm.collectionVariables.set('email', 'student-' + pm.variables.replaceIn('{{$guid}}') + '@example.test');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Assignment Student\",\n  \"email\": \"{{email}}\",\n  \"password\": \"ExamplePass123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Assignment Student\",\n  \"email\": \"{{email}}\",\n  \"password\": \"ExamplePass123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/posts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My first post\",\n  \"content\": \"Learning Node, Express and MongoDB\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('postId', pm.response.json().post._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Read all posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/posts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Read one post",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Update post",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/posts/{{postId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated post\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Title updated', () => pm.expect(pm.response.json().post.title).to.eql('Updated post'));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Delete post",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Confirm deleted",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/users/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Confirm logged out",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/posts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"x\",\n  \"content\": \"y\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
